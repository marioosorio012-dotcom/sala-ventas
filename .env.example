# Copia este archivo como .env.local y llena los valores de tu proyecto Supabase
# (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Llave secreta: SOLO en el servidor (Vercel → Environment Variables). Nunca la compartas.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
